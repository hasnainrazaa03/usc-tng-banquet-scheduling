# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="USC Town & Gown Banquet Operations"

# --- Auth ---
# Generate a strong secret: `openssl rand -base64 32`
AUTH_SECRET="dev-secret-change-me-please-use-a-long-random-string"

# --- Database ---
# PostgreSQL (recommended for production)
# Use the docker-compose.yml in this repo: `docker compose up -d`
DATABASE_URL="postgresql://tng:tng@localhost:5432/tng_scheduling?schema=public"

# --- AI (optional, used by /ai endpoints; system still works without keys) ---
OPENAI_API_KEY=""
